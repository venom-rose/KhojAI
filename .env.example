# ==============================================================================
# KHOJAI (Hidden India AI) — Production Environment Configuration Template
# ==============================================================================

# Application
APP_NAME=KHOJAI
APP_ENV=development # Set to 'production' in production deployments
DEBUG=False
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Frontend API URL configuration
VITE_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Database Configuration (PostgreSQL 16)
# Format: postgresql+asyncpg://user:password@host:port/database_name
# SQLite async fallback for local zero-dependency testing: sqlite+aiosqlite:///./khojai.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khojai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=False

# Authentication & Security
# WARNING: Must be generated with cryptographic randomness (e.g. `openssl rand -hex 32`).
# The server will strictly enforce minimum 32 characters length.
JWT_SECRET=replace_this_with_a_super_secret_cryptographic_key_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=app_session_id
COOKIE_SECURE=False # Automatically enforced True when APP_ENV=production
COOKIE_SAME_SITE=lax

# Redis Configuration (Optional for distributed rate limiting & caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# AI & LLM Provider Configuration
# Supported providers: 'local' (offline embedded), 'gemini', 'openai'
AI_PROVIDER=local
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
AI_MODEL_NAME=khojai-explorer-v1
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=3
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=text-embedding-004

# Media & Storage (Secure non-executable directory)
STORAGE_BACKEND=local
MEDIA_DIR=./media
MAX_UPLOAD_SIZE_MB=20

# Travel Provider APIs (Amadeus, Google Places, Local DB)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
GOOGLE_MAPS_API_KEY=
TRAVEL_CACHE_TTL_SECONDS=3600
TRAVEL_API_TIMEOUT_SECONDS=10.0
TRAVEL_API_MAX_RETRIES=2
TRAVEL_DEFAULT_PROVIDER=amadeus

# CORS Origins (Comma-separated exact origins, never use '*' with credentials)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ==============================================================================
# Vercel Production Deployment — Additional Environment Variables
# ==============================================================================
# Set these in the Vercel project dashboard (Settings → Environment Variables).
# NEVER commit real values to source control.

# Frontend: tells the Vite-built SPA where the API lives.
# On Vercel this can stay as /api/v1 because routing is handled by vercel.json.
VITE_API_BASE_URL=/api/v1

# Production application settings (override the development defaults above)
# APP_ENV=production
# DEBUG=False
# COOKIE_SECURE=True

# Production PostgreSQL (e.g. Supabase, Neon, Railway, Render)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>

# Production CORS — add your Vercel deployment domain, e.g.:
# CORS_ORIGINS=https://khojai.vercel.app,https://khojai.yourdomain.com

# Production JWT secret — generate with: openssl rand -hex 32
# JWT_SECRET=<64-char-hex-string>
