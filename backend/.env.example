# ==============================================================================
# KHOJAI (Hidden India AI) — Backend Environment Configuration Template
# ==============================================================================

# Application
APP_NAME=KHOJAI
APP_ENV=development # 'development' | 'production' | 'test'
DEBUG=False
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL 16)
# Format: postgresql+asyncpg://user:password@host:port/database_name
# SQLite async fallback for local zero-dependency testing: sqlite+aiosqlite:///./khojai.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khojai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=False

# Authentication & Security
# WARNING: Generate with `openssl rand -hex 32`. Minimum 32 characters required.
JWT_SECRET=replace_this_with_a_super_secret_cryptographic_key_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=app_session_id
COOKIE_SECURE=False # Set to True in production (enforced via HTTPS)
COOKIE_SAME_SITE=lax

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# AI & LLM Provider Configuration
# Supported providers: 'local' | 'gemini' | 'openai'
AI_PROVIDER=local
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
AI_MODEL_NAME=khojai-explorer-v1
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=3
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=text-embedding-004

# Media & Storage
STORAGE_BACKEND=local
MEDIA_DIR=./media
MAX_UPLOAD_SIZE_MB=20

# CORS Origins (Comma-separated exact origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
